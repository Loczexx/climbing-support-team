{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMessage",
  "type": "object",
  "required": [
    "message_id",
    "sender",
    "receiver",
    "user_id",
    "type",
    "task_id",
    "content",
    "timestamp"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "receiver": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique user identifier is strictly required"
    },
    "type": {
      "enum": [
        "TASK",
        "TASK_RESULT",
        "RECOMMENDATION",
        "PROPOSAL",
        "MESSAGE",
        "ESCALATION",
        "CONTEXT_REQUEST"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "content": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
